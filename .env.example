# Copy to ".env" for local work. Every value is PUBLIC (it ends up in the browser bundle). Never put a secret key here.

# Supabase: Project Settings -> API. URL + publishable key only (Row Level Security protects the data).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API (sjks-backend). Leave empty in development to use the Vite proxy to http://localhost:8080
VITE_API_URL=

# Optional: link shown in the footer to the admin panel (sjks-admin), e.g. https://admin.saharangosag.com
VITE_ADMIN_URL=

# Optional form fallbacks (used only if the database / API is unreachable)
VITE_WEB3FORMS_KEY=
VITE_FORM_ENDPOINT=

# Optional: remote live.json (same shape as public/data/live.json)
VITE_LIVE_DATA_URL=

# Optional privacy-friendly analytics, e.g. saharangosag.com
VITE_PLAUSIBLE_DOMAIN=
