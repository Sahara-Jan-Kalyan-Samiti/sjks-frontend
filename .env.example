# Copy to ".env.local" for local work. Every value is PUBLIC (it is compiled into the browser bundle).
# Never put a secret or a Supabase service-role key in a NEXT_PUBLIC_ variable.

# Supabase: Project Settings -> API. URL + publishable key only (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where this website is published (canonical links, sitemap, share previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (sjks-backend). Leave empty in development: Next.js then forwards /api to http://localhost:8080
# (change the target with API_DEV_PROXY below). In production use e.g. https://api.saharangosag.com
NEXT_PUBLIC_API_URL=
# API_DEV_PROXY=http://localhost:8080

# Optional footer link to the admin panel (sjks-admin), e.g. https://admin.saharangosag.com
NEXT_PUBLIC_ADMIN_URL=

# Optional form fallbacks (used only if the database / API is unreachable)
NEXT_PUBLIC_WEB3FORMS_KEY=
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: remote live.json (same shape as public/data/live.json)
NEXT_PUBLIC_LIVE_DATA_URL=

# Optional privacy-friendly analytics, e.g. saharangosag.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
