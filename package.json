{
  "name": "sjks-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Public website of Sahara Jan Kalyan Samiti (React + TypeScript + Vite + Tailwind)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "export:admin": "tsx --tsconfig tsconfig.json scripts/export-admin-data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "postcss": "8.4.45",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.10",
    "tsx": "^4.23.15",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.71.2",
    "vite": "5.4.3",
    "vitest": "^2.1.9"
  }
}
