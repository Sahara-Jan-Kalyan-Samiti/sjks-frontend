{
  "name": "sjks-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Public website of Sahara Jan Kalyan Samiti (Next.js + TypeScript + Tailwind)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "export:admin": "tsx --tsconfig tsconfig.json scripts/export-admin-data.ts"
  },
  "dependencies": {
    "@sentry/browser": "^8.55.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^14.2.35",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "postcss": "8.4.45",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.10",
    "tsx": "^4.23.15",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ]
}
